{
  "name": "nocturne-hexo",
  "version": "1.0.0",
  "private": true,
  "description": "星舞互娱 · 基于 Hexo 7 + ShokaX 的技术博客",
  "scripts": {
    "clean": "hexo clean",
    "new": "hexo new post",
    "build": "hexo generate && pagefind --site public",
    "server": "hexo server",
    "poster": "node tools/poster/server.js --open",
    "studio": "node tools/studio/server.js --open",
    "deploy": "hexo deploy",
    "set-root": "node tools/set-site-root.js"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "hexo": "^7.3.0",
    "hexo-deployer-git": "^4.0.0",
    "hexo-feed": "^1.1.2",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-aether": "^0.0.6",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^5.0.0",
    "hexo-renderer-pug": "^3.0.0",
    "hexo-renderer-stylus": "^2.1.0",
    "hexo-server": "^3.0.0",
    "hexo-theme-shokax": "^0.5.4",
    "hexo-wordcount": "^6.0.1",
    "nyx-player": "^0.1.1",
    "shokax-uikit": "^0.0.5"
  },
  "devDependencies": {
    "pagefind": "^1.5.2"
  }
}
